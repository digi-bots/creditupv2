{
  "rewrites": [
    { "source": "/robots.txt", "destination": "/api/seo?f=robots" },
    { "source": "/sitemap.xml", "destination": "/api/seo?f=sitemap" },
    { "source": "/manifest.webmanifest", "destination": "/api/seo?f=manifest" }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [ { "key": "Cache-Control", "value": "no-cache" }, { "key": "Service-Worker-Allowed", "value": "/" } ] }
  ],
  "crons": [
    { "path": "/api/cron/overdue", "schedule": "0 3 * * *" }
  ]
}
